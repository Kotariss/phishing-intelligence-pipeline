# ==========================================
# Phishing Intelligence Pipeline — configuration
# Copy to .env (never commit .env: it holds API keys)
# ==========================================

# --- Knowledge base -------------------------------------------------------
# Local run: SQLite file. Docker Compose overrides it with PostgreSQL.
DATABASE_URL=sqlite:///./pipeline.db
POSTGRES_USER=phish_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=phishing_db

# --- Services ---------------------------------------------------------------
WORKER_HOST=localhost
WORKER_PORT=8000
SANDBOX_HOST=localhost
SANDBOX_PORT=8001
# Local development without the sandbox container: parse files / fetch URLs in the
# worker process. Breaks zone isolation — keep false in Docker.
SANDBOX_INPROCESS_FALLBACK=true

# --- LLM / VLM (optional) -------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint.
#   local -> Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1),
#            vLLM / llama.cpp server; no key needed
#   cloud -> remote endpoint authorised with an API key
#   off   -> deterministic extractors only
LLM_MODE=local
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=
LLM_CLOUD_BASE_URL=https://your-llm-endpoint.example/api
LLM_CLOUD_API_KEY=your_api_key_here
LLM_TEXT_MODEL=qwen2.5:7b
LLM_VISION_MODEL=qwen2.5vl:7b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# --- Sandbox limits -------------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_REDIRECTS=10
SANDBOX_MAX_FILE_SIZE_MB=25
ANTI_SSRF_ENABLED=true

# --- Verdict thresholds -----------------------------------------------------------
SCORE_CLEAN_THRESHOLD=0.30
SCORE_MALICIOUS_THRESHOLD=0.70
