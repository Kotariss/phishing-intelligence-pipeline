# ==========================================
# Phishing Intelligence Pipeline — configuration
# Copy to .env (never commit .env: it holds API keys)
# ==========================================

# --- Knowledge base -------------------------------------------------------
# Local run: SQLite file. Docker Compose overrides it with PostgreSQL.
DATABASE_URL=sqlite:///./pipeline.db
POSTGRES_USER=phish_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=phishing_db

# --- Services ---------------------------------------------------------------
WORKER_HOST=localhost
WORKER_PORT=8000
SANDBOX_HOST=localhost
SANDBOX_PORT=8001
# Local development without the sandbox container: parse files / fetch URLs in the
# worker process. Breaks zone isolation — keep false in Docker.
SANDBOX_INPROCESS_FALLBACK=true

# --- LLM / VLM (required) -------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint; each mode has its own models.
#   local -> no external network. In Docker: the `llm` container (Ollama with Qwen models,
#            downloaded once by `llm-init`). Outside Docker: Ollama http://localhost:11434/v1,
#            LM Studio http://localhost:1234/v1, vLLM / llama.cpp server. No key needed.
#   cloud -> remote endpoint authorised with an API key.
LLM_MODE=local   # local | cloud | off (off: structural extractors only, no model)
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=
LLM_LOCAL_TEXT_MODEL=qwen3-vl:2b-instruct
LLM_LOCAL_VISION_MODEL=qwen3-vl:2b-instruct
LLM_CLOUD_BASE_URL=https://your-llm-endpoint.example/api
LLM_CLOUD_API_KEY=your_api_key_here
LLM_CLOUD_TEXT_MODEL=your-cloud-model
LLM_CLOUD_VISION_MODEL=
# reasoning_effort sent to the model; empty = not sent. The cloud model needs its reasoning for correct
# answers; set "none" only for a local "thinking" model (on CPU its hidden reasoning takes minutes).
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180
# attempts per call (pauses 2, 5, 10 s); after the last one the object is skipped and reported
LLM_ATTEMPTS=4

# --- Sandbox limits -------------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_REDIRECTS=10
SANDBOX_MAX_FILE_SIZE_MB=25
ANTI_SSRF_ENABLED=true

# --- Verdict thresholds -----------------------------------------------------------
SCORE_CLEAN_THRESHOLD=0.30
SCORE_MALICIOUS_THRESHOLD=0.70
