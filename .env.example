# ==========================================
# Phishing Intelligence Pipeline Config
# ==========================================

# Database Settings (PostgreSQL or SQLite fallback)
POSTGRES_USER=phish_user
POSTGRES_PASSWORD=phish_password
POSTGRES_DB=phishing_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./pipeline.db

# Service Endpoints
WORKER_HOST=localhost
WORKER_PORT=8000
SANDBOX_HOST=localhost
SANDBOX_PORT=8001
UI_PORT=8501

# LLM & Vision VLM Providers (NSU Cloud API / OpenAI Compatible / Ollama)
LLM_BASE_URL=https://your-llm-endpoint.example/api
LLM_API_KEY=your_llm_api_key_here
LLM_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
LLM_VISION_MODEL=Qwen3.8-27B
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45

# Ollama Fallback Settings (optional)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_ENABLED=false

# Security & Sandbox Limits
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_REDIRECTS=10
SANDBOX_MAX_FILE_SIZE_MB=25
ANTI_SSRF_ENABLED=true

# Scoring & Zero FPR Guard Thresholds
SCORE_CLEAN_THRESHOLD=0.30
SCORE_MALICIOUS_THRESHOLD=0.70

ENVIRONMENT=development
LOG_LEVEL=INFO
